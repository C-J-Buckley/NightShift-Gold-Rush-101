const markup = `<div class="overlay-frame" id="overlayFrame">
  <canvas id="overlay" width="1920" height="1080" aria-label="Animated digging overlay"></canvas>
  <div class="overlay-chrome" id="overlayChrome">
    <button class="overlay-close" id="overlayClose" type="button" aria-label="Close overlay">X</button>
    <div class="overlay-last-update" id="overlayLastUpdate">LAST UPDATE --:-- --</div>
  </div>
</div>`;

function patchScriptForLoader(script, replacementFor) {
  let patched = script;

  for (const file of assetFiles) {
    const literal = `"operation-gold-rush-assets/${file}"`;
    patched = patched.replaceAll(literal, replacementFor(file));
  }

  patched = patched.replace(
    `overlayClose.addEventListener("click", () => {\n        canvas.remove();\n        overlayChrome.remove();\n      });`,
    `overlayClose.addEventListener("click", () => {\n        window.__operatorGoldRushCleanup?.();\n      });`,
  );

  patched = patched.replace(
    "function drawFrame(now) {",
    "function drawFrame(now) {\n        if (!window.__operatorGoldRushActive) return;",
  );

  return patched;
}

function wrap(patchedScript, { standalone }) {
  return `(() => {
  "use strict";

  const ROOT_ID = "operatorGoldRushRoot";
  const STYLE_ID = "operatorGoldRushStyle";
  const existing = document.getElementById(ROOT_ID);
  if (existing) {
    existing.__cleanup?.();
    return;
  }

  window.__operatorGoldRushActive = true;

  const root = document.createElement("div");
  root.id = ROOT_ID;
  root.innerHTML = ${JSON.stringify(markup)};

  const style = document.createElement("style");
  style.id = STYLE_ID;
  style.textContent = ${JSON.stringify(css)};

  window.__operatorGoldRushCleanup = () => {
    window.__operatorGoldRushActive = false;
    document.getElementById(ROOT_ID)?.remove();
    document.getElementById(STYLE_ID)?.remove();
    delete window.__operatorGoldRushCleanup;
  };
  root.__cleanup = window.__operatorGoldRushCleanup;

  document.head.appendChild(style);
  document.body.appendChild(root);

${standalone ? "" : `  const scriptUrl = document.currentScript?.src || "";
  const defaultAssetBase = scriptUrl ? new URL("operation-gold-rush-assets/", scriptUrl).href : "operation-gold-rush-assets/";
  const assetBase = window.OPERATOR_GOLD_RUSH_ASSET_BASE || defaultAssetBase;

`}${patchedScript}
})();
`;
}

const externalPatched = patchScriptForLoader(
  originalScript,
  (file) => `assetBase + ${JSON.stringify(file)}`,
);
const externalJs = wrap(externalPatched, { standalone: false });
await writeFile(path.join(cwd, "operator-gold-rush-overlay.js"), externalJs, "utf8");

const dataUrls = new Map();
for (const file of assetFiles) {
  const bytes = await readFile(path.join(cwd, "operation-gold-rush-assets", file));
  dataUrls.set(file, `data:image/png;base64,${Buffer.from(bytes).toString("base64")}`);
}

const standalonePatched = patchScriptForLoader(
  originalScript,
  (file) => JSON.stringify(dataUrls.get(file)),
);
const standaloneJs = wrap(standalonePatched, { standalone: true });
await writeFile(path.join(cwd, "operator-gold-rush-overlay-standalone.js"), standaloneJs, "utf8");

console.log(`Wrote operator-gold-rush-overlay.js (${externalJs.length} chars)`);
console.log(`Wrote operator-gold-rush-overlay-standalone.js (${standaloneJs.length} chars)`);
