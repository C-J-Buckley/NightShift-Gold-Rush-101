import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

const cwd = "/Users/clifton.buckley/Documents";
const html = await readFile(path.join(cwd, "digging-overlay-animated.html"), "utf8");
const scriptMatch = html.match(/<script>([\s\S]*)<\/script>/);

if (!scriptMatch) {
  throw new Error("Could not find script block in digging-overlay-animated.html");
}

const originalScript = scriptMatch[1].trim();
const assetFiles = [
  "miner-sprites-option-c-transparent.png",
  "miner-excitement-transparent.png",
  "miner-excitement-mirrored-transparent.png",
  "celebration-scene-transparent.png",
];

const css = `
#operatorGoldRushRoot {
  position: fixed;
  inset: 0;
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  pointer-events: auto;
}
#operatorGoldRushRoot .overlay-frame {
  position: relative;
  width: min(100vw, calc(100vh * 16 / 9));
  height: min(100vh, calc(100vw * 9 / 16));
}
#operatorGoldRushRoot canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  background: transparent;
}
#operatorGoldRushRoot .overlay-chrome {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  image-rendering: pixelated;
}
#operatorGoldRushRoot .overlay-close {
  box-sizing: border-box;
  width: 18px;
  height: 16px;
  border: 1px solid #2a180f;
  box-shadow: inset 0 0 0 1px #ffd23f, 1px 1px 0 #050815;
  background: #8b2d20;
  color: #fff5c6;
  cursor: pointer;
  font: 700 8px/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  text-align: center;
